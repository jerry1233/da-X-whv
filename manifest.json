{
  "name": "打工度假自动填表插件-大X-纽澳多用版",
  "author": "澳打君",
  "version": "3.6.0",
  "manifest_version": 3,
  "description": "澳大利亚新西兰打工度假签证大X插件(纽澳多用版)，自动点击，自动填表。在仅填表模式下，可使用快捷键 Ctrl+Shift+S （ Mac Command+Shift+S ）实现该页填表+提交",
  "action": {
    "default_icon": "images/icon.png",
    "default_title": "大X插件多用版",
    "default_popup": "popup.html"
  },
  "commands": {
    "click-page-cation": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "click-page-cation"
    }
  },
  "icons": {
    "19": "images/icon.png",
    "32": "images/icon32.png",
    "38": "images/icon38.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "static/background/index.js"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/jquery-3.5.1.min.js",
        "content_script.js"
      ],
      "exclude_matches": [
        "*://*.paymark.co.nz/*"
      ]
    }
  ],
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' data:"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
